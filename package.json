{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "node backend/index.js",
    "server": "node backend/index.js",
    "dev:full": "concurrently --names \"api,web\" --prefix-colors \"cyan,green\" \"npm run server\" \"npm run dev\"",
    "cert": "node scripts/generate-dev-cert.mjs",
    "dev:lan": "node scripts/preflight-lan.mjs && DEV_HTTPS=1 concurrently --names \"api,web\" --prefix-colors \"cyan,green\" \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:render && npm run test:e2e && npm run test:admin",
    "test:e2e": "node scripts/e2e-booking-video.mjs",
    "test:admin": "node scripts/e2e-content-admin.mjs",
    "test:render": "node scripts/render-smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sqlite3": "^6.0.1",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
