node_modules/
dist/
build/
.cache/

# Local SQLite database and its write-ahead log. Recreated and reseeded on boot.
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# Self-signed development certificates. Regenerate with `npm run cert`.
certs/
.env*
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*
/.figma/design-context/

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Uploaded images (user content, not part of the build)
backend/data/uploads/

# This project uses pnpm (see .mise.toml and the Figma harness). A stray
# npm lockfile makes the package manager ambiguous for the deploy builder.
package-lock.json
